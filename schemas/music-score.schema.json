{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ArabKustam/Plugin-Minecraft-studio/main/schemas/music-score.schema.json",
  "title": "Minecraft Studio music score",
  "type": "object",
  "required": [
    "bpm",
    "sections",
    "stems"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "bpm": {
      "type": "number",
      "minimum": 30,
      "maximum": 300
    },
    "meter": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "key": {
      "type": "string"
    },
    "transition_every_bars": {
      "type": "integer",
      "minimum": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "bars"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "bars": {
            "type": "integer",
            "minimum": 1
          },
          "loop": {
            "type": "boolean"
          }
        }
      }
    },
    "stems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "instrument"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "instrument": {
            "description": "Real sampled instrument (General MIDI name, alias, gm:<0-127>, or drum kit) or synth voice (synth:<name> or the bare legacy name).",
            "anyOf": [
              {
                "title": "General MIDI instrument",
                "enum": [
                  "acoustic_grand_piano",
                  "bright_acoustic_piano",
                  "electric_grand_piano",
                  "honky_tonk_piano",
                  "electric_piano_1",
                  "electric_piano_2",
                  "harpsichord",
                  "clavinet",
                  "celesta",
                  "glockenspiel",
                  "music_box",
                  "vibraphone",
                  "marimba",
                  "xylophone",
                  "tubular_bells",
                  "dulcimer",
                  "drawbar_organ",
                  "percussive_organ",
                  "rock_organ",
                  "church_organ",
                  "reed_organ",
                  "accordion",
                  "harmonica",
                  "tango_accordion",
                  "nylon_guitar",
                  "steel_guitar",
                  "jazz_guitar",
                  "clean_electric_guitar",
                  "muted_electric_guitar",
                  "overdriven_guitar",
                  "distortion_guitar",
                  "guitar_harmonics",
                  "acoustic_bass",
                  "fingered_bass",
                  "picked_bass",
                  "fretless_bass",
                  "slap_bass_1",
                  "slap_bass_2",
                  "synth_bass_1",
                  "synth_bass_2",
                  "violin",
                  "viola",
                  "cello",
                  "contrabass",
                  "tremolo_strings",
                  "pizzicato_strings",
                  "orchestral_harp",
                  "timpani",
                  "string_ensemble_1",
                  "string_ensemble_2",
                  "synth_strings_1",
                  "synth_strings_2",
                  "choir_aahs",
                  "voice_oohs",
                  "synth_voice",
                  "orchestra_hit",
                  "trumpet",
                  "trombone",
                  "tuba",
                  "muted_trumpet",
                  "french_horn",
                  "brass_section",
                  "synth_brass_1",
                  "synth_brass_2",
                  "soprano_sax",
                  "alto_sax",
                  "tenor_sax",
                  "baritone_sax",
                  "oboe",
                  "english_horn",
                  "bassoon",
                  "clarinet",
                  "piccolo",
                  "flute",
                  "recorder",
                  "pan_flute",
                  "blown_bottle",
                  "shakuhachi",
                  "whistle",
                  "ocarina",
                  "square_lead",
                  "sawtooth_lead",
                  "calliope_lead",
                  "chiff_lead",
                  "charang_lead",
                  "voice_lead",
                  "fifths_lead",
                  "bass_and_lead",
                  "new_age_pad",
                  "warm_pad",
                  "polysynth_pad",
                  "choir_pad",
                  "bowed_pad",
                  "metallic_pad",
                  "halo_pad",
                  "sweep_pad",
                  "rain_fx",
                  "soundtrack_fx",
                  "crystal_fx",
                  "atmosphere_fx",
                  "brightness_fx",
                  "goblins_fx",
                  "echoes_fx",
                  "sci_fi_fx",
                  "sitar",
                  "banjo",
                  "shamisen",
                  "koto",
                  "kalimba",
                  "bagpipe",
                  "fiddle",
                  "shanai",
                  "tinkle_bell",
                  "agogo",
                  "steel_drums",
                  "woodblock",
                  "taiko_drum",
                  "melodic_tom",
                  "synth_drum",
                  "reverse_cymbal",
                  "guitar_fret_noise",
                  "breath_noise",
                  "seashore",
                  "bird_tweet",
                  "telephone_ring",
                  "helicopter",
                  "applause",
                  "gunshot"
                ]
              },
              {
                "title": "Drum kit (parts are step patterns)",
                "enum": [
                  "drum_kit",
                  "standard_kit",
                  "room_kit",
                  "power_kit",
                  "electronic_kit",
                  "tr808_kit",
                  "jazz_kit",
                  "brush_kit",
                  "orchestra_kit"
                ]
              },
              {
                "title": "Alias",
                "enum": [
                  "piano",
                  "grand_piano",
                  "acoustic_piano",
                  "bright_piano",
                  "honky_tonk",
                  "rhodes",
                  "electric_piano",
                  "epiano",
                  "dx_piano",
                  "organ",
                  "guitar",
                  "classical_guitar",
                  "acoustic_guitar",
                  "electric_guitar",
                  "double_bass",
                  "upright_bass",
                  "electric_bass",
                  "harp",
                  "pizzicato",
                  "string_ensemble",
                  "strings_section",
                  "slow_strings",
                  "horn",
                  "sax",
                  "choir_real",
                  "aahs",
                  "oohs",
                  "bells",
                  "chimes",
                  "steelpan",
                  "фортепиано",
                  "пианино",
                  "рояль",
                  "электропиано",
                  "челеста",
                  "шкатулка",
                  "музыкальная_шкатулка",
                  "вибрафон",
                  "маримба",
                  "ксилофон",
                  "колокола",
                  "колокольчики",
                  "орган",
                  "аккордеон",
                  "губная_гармошка",
                  "гитара",
                  "акустическая_гитара",
                  "электрогитара",
                  "бас",
                  "контрабас",
                  "скрипка",
                  "альт",
                  "виолончель",
                  "струнные",
                  "пиццикато",
                  "арфа",
                  "литавры",
                  "хор",
                  "труба",
                  "тромбон",
                  "туба",
                  "валторна",
                  "медь",
                  "саксофон",
                  "гобой",
                  "фагот",
                  "кларнет",
                  "флейта",
                  "пикколо",
                  "блокфлейта",
                  "пан_флейта",
                  "окарина",
                  "ситар",
                  "банджо",
                  "кото",
                  "калимба",
                  "волынка",
                  "стилдрам",
                  "тайко",
                  "ударные",
                  "барабаны"
                ]
              },
              {
                "title": "Synth voice",
                "enum": [
                  "pad",
                  "strings",
                  "bass",
                  "pluck",
                  "bell",
                  "choir",
                  "lead",
                  "drone",
                  "brass",
                  "drums",
                  "pulse",
                  "sub",
                  "synth:pad",
                  "synth:strings",
                  "synth:bass",
                  "synth:pluck",
                  "synth:bell",
                  "synth:choir",
                  "synth:lead",
                  "synth:drone",
                  "synth:brass",
                  "synth:drums",
                  "synth:pulse",
                  "synth:sub"
                ]
              },
              {
                "title": "GM program number",
                "type": "string",
                "pattern": "^gm:([0-9]|[1-9][0-9]|1[01][0-9]|12[0-7])$"
              }
            ]
          },
          "gain": {
            "type": "number"
          },
          "pan": {
            "type": "number"
          },
          "vowel": {
            "enum": [
              "a",
              "o",
              "u",
              "e",
              "i"
            ]
          },
          "transpose": {
            "type": "integer",
            "description": "Semitones; fractional values detune (pitch bend for sampled instruments)."
          },
          "legato": {
            "type": "number",
            "description": "Note length factor (default 0.98). Above 1, notes overlap the next ones, like a sustain pedal on arpeggios."
          },
          "repeat": {
            "type": "boolean"
          },
          "effects": {
            "type": "array"
          },
          "parts": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Melodic part"
                },
                {
                  "type": "object",
                  "description": "Melodic part with options, or a drum step-pattern object",
                  "properties": {
                    "notes": {
                      "type": "string"
                    },
                    "velocity": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 2,
                      "description": "Velocity multiplier for this section (dynamics)"
                    },
                    "transpose": {
                      "type": "number",
                      "description": "Semitones for this section (key change)"
                    },
                    "pattern": {
                      "type": "object",
                      "description": "Drum step patterns when the part also sets velocity"
                    }
                  }
                }
              ]
            }
          },
          "velocity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Velocity multiplier for the whole stem (sampled instruments change timbre with velocity)."
          },
          "pedal": {
            "type": "boolean",
            "description": "Hold the sustain pedal for the whole part (sampled instruments)."
          }
        }
      }
    },
    "soundfont": {
      "type": "string",
      "description": "Optional .sf2/.sf3 sound bank for sampled instruments (project-relative or absolute). Default: GeneralUser GS installed by audio_soundfont_install."
    },
    "full_mix": {
      "type": "boolean",
      "description": "Also render the whole arrangement as one continuous track (<title>_full). Default: true when there is no loop section (a song)."
    },
    "loop_repeats": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "How many times the loop section plays inside the full mix."
    },
    "normalize_on": {
      "type": "string",
      "description": "What the loudness target is measured on: \"full\", \"loop\" or a section name. Default: full mix for songs, else the loop."
    }
  }
}
