{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ArabKustam/Plugin-Minecraft-studio/main/schemas/sfx-recipe.schema.json",
  "title": "Minecraft Studio SFX recipe",
  "type": "object",
  "required": [
    "duration",
    "layers"
  ],
  "properties": {
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 120
    },
    "sample_rate": {
      "type": "integer"
    },
    "channels": {
      "enum": [
        1,
        2
      ]
    },
    "loop": {
      "type": "boolean"
    },
    "loop_crossfade": {
      "type": "number"
    },
    "tail": {
      "type": "number"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "osc",
              "noise",
              "fm",
              "chirp",
              "click",
              "impact",
              "sample",
              "voice",
              "modal",
              "scrape"
            ]
          },
          "name": {
            "type": "string"
          },
          "wave": {
            "enum": [
              "sine",
              "square",
              "saw",
              "triangle",
              "pulse25"
            ]
          },
          "freq": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "number"
                  },
                  "to": {
                    "type": "number"
                  },
                  "curve": {
                    "enum": [
                      "linear",
                      "exp",
                      "ease"
                    ]
                  },
                  "start": {
                    "type": "number"
                  },
                  "end": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "center"
                ],
                "properties": {
                  "center": {
                    "type": "number"
                  },
                  "depth": {
                    "type": "number"
                  },
                  "rate": {
                    "type": "number"
                  },
                  "shape": {
                    "enum": [
                      "sine",
                      "triangle",
                      "square"
                    ]
                  }
                }
              }
            ]
          },
          "carrier": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "number"
                  },
                  "to": {
                    "type": "number"
                  },
                  "curve": {
                    "enum": [
                      "linear",
                      "exp",
                      "ease"
                    ]
                  },
                  "start": {
                    "type": "number"
                  },
                  "end": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "center"
                ],
                "properties": {
                  "center": {
                    "type": "number"
                  },
                  "depth": {
                    "type": "number"
                  },
                  "rate": {
                    "type": "number"
                  },
                  "shape": {
                    "enum": [
                      "sine",
                      "triangle",
                      "square"
                    ]
                  }
                }
              }
            ]
          },
          "index": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "number"
                  },
                  "to": {
                    "type": "number"
                  },
                  "curve": {
                    "enum": [
                      "linear",
                      "exp",
                      "ease"
                    ]
                  },
                  "start": {
                    "type": "number"
                  },
                  "end": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "center"
                ],
                "properties": {
                  "center": {
                    "type": "number"
                  },
                  "depth": {
                    "type": "number"
                  },
                  "rate": {
                    "type": "number"
                  },
                  "shape": {
                    "enum": [
                      "sine",
                      "triangle",
                      "square"
                    ]
                  }
                }
              }
            ]
          },
          "ratio": {
            "type": "number"
          },
          "harmonics": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "voices": {
            "type": "integer"
          },
          "detune": {
            "type": "number"
          },
          "color": {
            "enum": [
              "white",
              "pink",
              "brown"
            ]
          },
          "start": {
            "type": "number"
          },
          "duration": {
            "type": "number"
          },
          "gain": {
            "type": "number"
          },
          "pan": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "envelope": {
            "type": "object"
          },
          "filter": {
            "type": "object"
          },
          "filters": {
            "type": "array"
          },
          "effects": {
            "type": "array"
          },
          "file": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "pitch": {
            "description": "voice: fundamental in Hz (number, {from,to}, {center,depth,rate} or {points:[[t,v]...]})"
          },
          "vowel": {
            "description": "voice: 'a','e','i','o','u','ae','uh','er','ah','oo','h' or [[time, vowel], ...] morph"
          },
          "size": {
            "type": "number",
            "description": "voice: formant scale (0.8 child, 1 adult, 1.5-2 monster)"
          },
          "breath": {
            "description": "voice: breathiness 0..1 (param)"
          },
          "rough": {
            "description": "voice: subharmonic growl 0..1 (param)"
          },
          "strain": {
            "type": "number",
            "description": "voice: pressed/screamed 0..1"
          },
          "jitter": {
            "type": "number",
            "description": "voice: pitch instability 0..1"
          },
          "vibrato": {
            "type": "object",
            "properties": {
              "rate": {
                "type": "number"
              },
              "depth": {
                "type": "number",
                "description": "semitones"
              }
            }
          },
          "pulses": {
            "type": "object",
            "description": "voice: syllables (laughter, sobs, panting)",
            "properties": {
              "rate": {},
              "duty": {
                "type": "number"
              },
              "jitter": {
                "type": "number"
              },
              "pitch_jitter": {
                "type": "number"
              },
              "accent": {
                "type": "number"
              },
              "skip": {
                "type": "number"
              }
            }
          },
          "material": {
            "enum": [
              "metal",
              "metal_plate",
              "pipe",
              "glass",
              "wood",
              "stone",
              "string"
            ],
            "description": "modal/scrape: resonance set"
          },
          "partials": {
            "type": "array",
            "description": "modal/scrape: custom [[ratio, gain, decayMul]...]"
          },
          "decay": {
            "type": "number",
            "description": "modal: decay of the fundamental (s); impact/click: decay"
          },
          "hits": {
            "description": "modal: [time...] / [{t, vel, freq}...] or {count, start, end, distribution: uniform|decay|burst, vel_from, vel_to}"
          },
          "freq_spread": {
            "type": "number",
            "description": "modal: random size per hit (shards, splinters)"
          },
          "brightness": {
            "type": "number",
            "description": "modal: strike noise 0..1"
          },
          "damping": {
            "type": "number"
          },
          "speed": {
            "description": "scrape: slips per second (param)"
          },
          "pressure": {
            "description": "scrape: 0..1 (param)"
          },
          "grit": {
            "type": "number",
            "description": "scrape: continuous noise 0..1"
          },
          "squeal": {
            "type": "number",
            "description": "scrape: resonance emphasis 0..1"
          },
          "q": {
            "type": "number",
            "description": "scrape: resonance sharpness"
          },
          "repeat": {
            "type": "object",
            "description": "Copies of this layer: {times:[...]} or {count, interval, jitter, gain_jitter (dB), pitch_jitter (semitones), accel, fade_db}",
            "properties": {
              "times": {
                "type": "array"
              },
              "count": {
                "type": "integer"
              },
              "interval": {
                "type": "number"
              },
              "jitter": {
                "type": "number"
              },
              "gain_jitter": {
                "type": "number"
              },
              "pitch_jitter": {
                "type": "number"
              },
              "accel": {
                "type": "number"
              },
              "fade_db": {
                "type": "number"
              }
            }
          },
          "drop": {
            "type": "number"
          },
          "noise": {
            "type": "number"
          },
          "rate": {
            "type": "number"
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ]
      }
    },
    "normalize": {
      "type": "object",
      "properties": {
        "lufs": {
          "type": "number"
        },
        "peak": {
          "type": "number"
        },
        "ceiling": {
          "type": "number",
          "description": "Final limiter ceiling in dBFS (default -1); use -2...-4 for sharp transients that Ogg encoding overshoots"
        }
      }
    }
  }
}
