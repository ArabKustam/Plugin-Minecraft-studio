{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "studio:hollow_wraith",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/hollow_wraith"
      },
      "geometry": {
        "default": "geometry.hollow_wraith"
      },
      "animations": {
        "idle": "animation.hollow_wraith.idle",
        "walk": "animation.hollow_wraith.walk",
        "attack": "animation.hollow_wraith.attack"
      },
      "scripts": {
        "animate": [
          {
            "idle": "query.modified_move_speed < 0.05"
          },
          {
            "walk": "query.modified_move_speed >= 0.05"
          },
          {
            "attack": "variable.attack_time > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "base_color": "#1d1a26",
        "overlay_color": "#7ff5ff"
      }
    }
  }
}
