{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "studio:highland_ox",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/highland_ox"
      },
      "geometry": {
        "default": "geometry.highland_ox"
      },
      "animations": {
        "idle": "animation.highland_ox.idle",
        "walk": "animation.highland_ox.walk",
        "attack": "animation.highland_ox.attack"
      },
      "scripts": {
        "animate": [
          {
            "idle": "query.modified_move_speed < 0.05"
          },
          {
            "walk": "query.modified_move_speed >= 0.05"
          },
          {
            "attack": "variable.attack_time > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "base_color": "#7a3a17",
        "overlay_color": "#dccba0"
      }
    }
  }
}
