{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "studio:rust_crawler",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/rust_crawler"
      },
      "geometry": {
        "default": "geometry.rust_crawler"
      },
      "animations": {
        "idle": "animation.rust_crawler.idle",
        "walk": "animation.rust_crawler.walk",
        "attack": "animation.rust_crawler.attack"
      },
      "scripts": {
        "animate": [
          {
            "idle": "query.modified_move_speed < 0.05"
          },
          {
            "walk": "query.modified_move_speed >= 0.05"
          },
          {
            "attack": "variable.attack_time > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "base_color": "#5a2f1c",
        "overlay_color": "#6fbf2c"
      }
    }
  }
}
