# Minecraft Studio — optional provider credentials.
# Copy to `.env` in YOUR MINECRAFT PROJECT (not this repo), or export them in your shell.
# `.env` is git-ignored by /minecraft-studio:init. Never commit real keys.

# ElevenLabs: production voice lines, AI sound effects, music (paid, optional).
# Alternatively set it in the plugin option "elevenlabs_api_key" (stored in secure storage).
ELEVENLABS_API_KEY=

# GitHub: only needed if you use the gh CLI / GitHub MCP outside Claude's own connector.
GITHUB_TOKEN=

# Optional overrides
# MINECRAFT_STUDIO_FFMPEG=C:/tools/ffmpeg/bin/ffmpeg.exe
# MINECRAFT_STUDIO_CAPABILITIES=read,write,execute,publish
